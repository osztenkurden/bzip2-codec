{
	"name": "bzip2-codec",
	"version": "1.3.1",
	"description": "Dependency-free bzip2 compression and decompression for Web Streams",
	"type": "module",
	"engines": {
		"node": ">=22.12.0"
	},
	"exports": {
		".": "./dist/index.mjs",
		"./js": "./dist/js.mjs",
		"./package.json": "./package.json",
		"./wasm": "./dist/wasm.mjs"
	},
	"types": "./dist/index.d.mts",
	"bin": {
		"bzip2-codec": "./dist/cli.mjs"
	},
	"files": [
		"dist",
		"LICENSE",
		"NOTICE",
		"README.md",
		"wasm"
	],
	"scripts": {
		"test": "node --test",
		"test:parallel": "bun test --timeout 60000 test/parallel.test.ts test/parallel-worker.test.ts test/parallel-compress.test.ts test/wasm.test.ts",
		"test:parallel:large": "BZIP_LARGE_TESTS=1 bun test --timeout 120000 test/parallel-large.test.ts",
		"test:package": "BZIP_BUILT_TESTS=1 bun test --timeout 60000 test/package.test.ts test/cli.test.ts",
		"test:interop": "BZIP_INTEROP_TESTS=1 node --test test/interoperability.test.ts",
		"test:large": "BZIP_LARGE_TESTS=1 node --test test/large.test.ts",
		"memory:decompress": "bun scripts/memory-report.ts",
		"typecheck": "tsc",
		"benchmark:decompress": "bun scripts/benchmark-decompression.ts",
		"benchmark:compress": "bun scripts/benchmark-compression.ts",
		"benchmark:decoder": "bun scripts/benchmark-decoder.ts",
		"build": "tsdown",
		"pack:check": "npm pack --dry-run",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"build:wasm": "bun wasm/build.ts",
		"benchmark": "bun benchmark.ts"
	},
	"devDependencies": {
		"@types/bun": "^1.4.0",
		"@types/node": "^22.18.8",
		"prettier": "^3.6.2",
		"tsdown": "^0.22.7",
		"typescript": "^7.0.2"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/osztenkurden/bzip2-codec.git"
	},
	"license": "GPL-3.0",
	"bugs": {
		"url": "https://github.com/osztenkurden/bzip2-codec/issues"
	},
	"homepage": "https://github.com/osztenkurden/bzip2-codec#readme",
	"keywords": [
		"bzip2",
		"compression",
		"decompression",
		"streams",
		"typescript"
	],
	"sideEffects": false
}
